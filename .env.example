# Copy this file to .env and fill in your own values. .env is git-ignored: never commit real keys.

# --- LLM providers (at least one is required; both use the same model so failover keeps calibration valid) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=20
CLASSIFY_SAMPLES=3
LLM_CACHE_ENABLED=true

# --- Local models (downloaded once from Hugging Face) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# --- Storage ---
KB_PATH=./data/documentation.json
CHROMA_PATH=./storage/chroma
# SQLite (default) or PostgreSQL 16, e.g. postgresql://user:password@localhost:5432/cloudserve
DATABASE_URL=sqlite:///./storage/decisions.db

# --- Governance ---
# Every routing threshold comes from this calibration artifact (python -m evaluation.calibrate); none are set here.
THRESHOLD_CONFIG_PATH=./artifacts/thresholds_v1.json
# Incident kill switch: FULL_AUTONOMOUS | ASSIST_AND_ESCALATE_ONLY | PASSTHROUGH_QUEUE
ROUTING_MODE=FULL_AUTONOMOUS

# --- Security ---
# development | test | production. In production, API_KEY and CUSTOMER_ID_SALT are mandatory and startup fails without them.
APP_ENV=development
# Shared service key, sent by API clients as the X-API-Key header. Empty disables authentication in development only.
API_KEY=
# Keyed HMAC salt for hashing customer IDs (use a long random string; required in production)
CUSTOMER_ID_SALT=

# --- Evaluation harness (optional; command-line flags take precedence) ---
EVAL_INPUT_PATH=
EVAL_OUTPUT_DIR=

# --- Service ---
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
